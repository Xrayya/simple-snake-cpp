{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup CMake Debug/Dev",
      "type": "shell",
      "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
      "group": "build"
    },
    {
      "label": "Setup FRESH CMake Debug/Dev",
      "type": "shell",
      "command": "cmake --fresh -S . -B build -DCMAKE_BUILD_TYPE=Debug",
      "group": "build"
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "cmake --build build",
      "group": "build"
    },
    {
      "label": "Update and Build Debug",
      "dependsOn": ["Setup CMake Debug/Dev", "Build Debug"],
      "group": "build"
    },
    {
      "label": "Setup CMake Release",
      "type": "shell",
      "command": "cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release",
      "group": "build"
    },
    {
      "label": "Setup FRESH CMake Release",
      "type": "shell",
      "command": "cmake --fresh -S . -B build-release -DCMAKE_BUILD_TYPE=Release",
      "group": "build"
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "cmake --build build-release",
      "group": "build"
    },
    {
      "label": "Update and Build Release",
      "dependsOn": ["Setup CMake Release", "Build Release"],
      "group": "build"
    }
  ]
}
